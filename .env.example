# MongoDB Atlas connection string (or your local docker-compose Mongo instance).
# See docs/implementation-plan.md for how to provision an Atlas free-tier cluster.
MONGODB_URI=mongodb://localhost:27017/linux-commands

# Auth.js (NextAuth) — generate with `npx auth secret`.
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# GitHub OAuth app credentials, used to authenticate admins.
GITHUB_ID=
GITHUB_SECRET=

# Comma-separated GitHub usernames allowed to access /admin.
ADMIN_GITHUB_ALLOWLIST=
